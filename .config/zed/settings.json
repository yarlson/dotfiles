{
  "cli_default_open_behavior": "new_window",
  "project_panel": {
    "dock": "left"
  },
  "collaboration_panel": {
    "dock": "left"
  },
  "git_panel": {
    "dock": "left"
  },
  "colorize_brackets": true,
  "telemetry": {
    "diagnostics": false,
    "metrics": false,
  },
  "buffer_font_family": "JetBrainsMono Nerd Font Mono",
  "outline_panel": {
    "dock": "right",
  },
  "agent_servers": {
    "claude-acp": {
      "type": "registry",
      "default_mode": "bypassPermissions"
    },
    "opencode": {
      "type": "registry",
    },
  },
  "base_keymap": "JetBrains",
  "icon_theme": {
    "mode": "light",
    "light": "JetBrains New UI Icons (Dark)",
    "dark": "Zed (Default)",
  },
  "agent": {
    "tool_permissions": {
      "default": "allow"
    },
    "dock": "right",
    "inline_assistant_model": {
      "provider": "copilot_chat",
      "model": "claude-sonnet-4",
    },
    "default_model": {
      "provider": "openai",
      "model": "gpt-4o-mini",
    },
    "model_parameters": [],
  },
  "ui_font_size": 16,
  "buffer_font_size": 16,
  "theme": "Fleet Dark",
  "vim_mode": false,
  "vim": {
    "default_mode": "normal",
    "toggle_relative_line_numbers": true,
    "use_system_clipboard": "always",
    "use_smartcase_find": false,
    "highlight_on_yank_duration": 200,
    "custom_digraphs": {},
    "cursor_shape": {},
  },
  "tabs": {
    "git_status": true,
    "close_position": "right",
    "file_icons": true,
    "show_close_button": "hover",
    "activate_on_close": "history",
    "show_diagnostics": "errors",
  },
  "languages": {
    "PHP": {
      "language_servers": ["phpactor"],
    },
    "GDScript": {
      "formatter": {
        "external": {
          "command": "gdscript-formatter",
          "arguments": [],
        },
      },
    },
  },
  "lsp": {
    "tailwindcss-language-server": {
      "settings": {
        "classFunctions": ["cva", "cx"],
        "experimental": {
          "classRegex": ["[cls|className]\\s\\:\\=\\s\"([^\"]*)"],
        },
      },
    },
  },
}
